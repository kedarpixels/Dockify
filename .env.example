# Copy to .env for local development. Every value here is a placeholder, never a real secret.
# Each secret also accepts a <NAME>_FILE variant that points at a file, which wins over the inline value.

# Control-plane database (docker compose up postgres)
DATABASE_URL=postgresql://dockify:dockify-local-dev@127.0.0.1:55432/dockify
# Scratch database for the DB-backed tests; they are skipped when this is unset.
DATABASE_URL_TEST=
# Shadow database for the schema drift check (pnpm db:drift)
SHADOW_DATABASE_URL=

# Master key that seals every stored secret. Generate: openssl rand -base64 32
# Losing it makes every stored secret unreadable. The api refuses known placeholder values.
DOCKIFY_MASTER_KEY=
# Comma separated previous keys, only while rotating: until `dockify admin rewrap-secrets` has run.
DOCKIFY_MASTER_KEY_PREVIOUS=

# The one browser-facing origin of the dashboard. https, or http on localhost only.
DOCKIFY_PUBLIC_URL=http://localhost:3006

# cloudflare_tunnel (default) or direct_tls (Traefik with Let's Encrypt, no Cloudflare)
DOCKIFY_INGRESS=cloudflare_tunnel
# Peers allowed to report the client address: the web container, plus Traefik (direct mode) and
# cloudflared (tunnel mode), which send /api/v1/ on the dashboard host straight to the api.
DOCKIFY_TRUSTED_PROXIES=127.0.0.1,::1

# Optional: when set, first-owner setup must present this token (the installer prints it).
DOCKIFY_SETUP_TOKEN=

# Shared secret between the api and the worker: the api presents it on the worker's data channel,
# the worker presents it on the api's secret-opening routes. Generate: openssl rand -base64 32
DOCKIFY_INTERNAL_TOKEN=
# Worker only: where the api answers on the control network. The worker holds no master key.
DOCKIFY_API_INTERNAL_URL=http://127.0.0.1:3001
# Api only: socket peers allowed on the internal routes (the worker's address). Empty: any peer with the token.
DOCKIFY_INTERNAL_PEERS=

PORT=3001
LOG_LEVEL=info

# Optional email through your own mail server (also settable later in Settings, Integrations).
# Used once, on first boot, so setup can verify the owner's email.
DOCKIFY_SMTP_HOST=
DOCKIFY_SMTP_PORT=
DOCKIFY_SMTP_USER=
DOCKIFY_SMTP_PASSWORD=
DOCKIFY_EMAIL_FROM=
DOCKIFY_EMAIL_FROM_NAME=
