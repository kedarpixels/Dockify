{
  "name": "@dockify/site",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "node scripts/publish-installer.mjs",
    "dev": "next dev --port 3007",
    "prebuild": "node scripts/publish-installer.mjs && node scripts/sync-ui.mjs --check",
    "build": "next build",
    "start": "next start --port 3007",
    "start:standalone": "node scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "eslint .",
    "icons": "node scripts/gen-icons.mjs",
    "sync-ui": "node scripts/sync-ui.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "geist-icons": "1.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.1"
  }
}
