{
  "name": "dockify",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @dockify/db generate",
    "db:migrate": "pnpm --filter @dockify/db migrate",
    "db:drift": "pnpm --filter @dockify/db drift"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
