/// The steps of a self-update, in order; rollback is appended when one runs.
enum UpdatePhase {
  preflight
  pull
  backup
  migrate
  swap_api
  swap_worker
  swap_web
  health
  rollback
}

enum UpdateState {
  /// Preflight found a deploy or restore in flight; the job retries shortly.
  waiting
  running
  done
  failed
  rolled_back
}

enum UpdateKind {
  update
  /// Back to the previous version: the pre-update dump of `rollbackOfId` and its images.
  rollback
}

enum UpdateTrigger {
  manual
  auto
  cli
}

enum UpdateMode {
  /// Notify only.
  manual
  /// Install only releases flagged critical, in the window.
  security
  /// Install every release on the channel, in the window.
  all
}

enum ReleaseChannel {
  stable
  beta
}

enum JobKind {
  deploy
  cancel_deploy
  remove_app
  backup
  restore
  restore_test
  prune
  janitor
  reconcile
  preview_cleanup
  preview_feedback
  preview_wake
  preview_dns
  self_update
  dns_check
  vercel_sync
  edge_route_sync
  edge_cf_wire
  edge_cf_unwire
  alert_notify
  factory_reset
  email_send
  /// Update available, updated, update failed: Discord and email, sent by the worker.
  update_notify
  /// Start, stop or restart one app's container, queued by the apps module.
  app_power
  /// Fetches a frontend's favicon from its own domains, after a deploy or on request.
  icon_fetch
  /// Emails the member who started a deploy that failed, when they asked for it.
  deploy_notify
  /// Mirrors one Vercel project's deployments now: queued by a verified Vercel webhook delivery.
  vercel_mirror
  /// One message to one notification webhook (update notices), retried on its own.
  webhook_send
  /// A newly seen security release: one email to every admin, queued once per release by the updater.
  security_notify
  /// Deletes an app's orphaned backups: the worker alone can write the local backups volume.
  backup_delete
  /// Checks the dashboard domain being set up, and prepares its switch. Queued by Settings.
  dashboard_domain
  /// Switches the dashboard to the checked domain: .env, then api, worker and web. Claimed by the updater.
  dashboard_domain_apply
  /// A preview became ready or failed: one email, to the member who opened the pull request or the admins.
  preview_notify
  /// One instance event with no rule behind it (a backup failed, a certificate near expiry): admins and webhooks.
  event_notify
  /// The commit status of a settled deploy on GitHub, through the App.
  deploy_status
  /// Reads a repository's build without deploying it: clone, then Railpack's plan in the BuildKit sandbox.
  build_detect
  /// One run of a scheduled job: a short-lived container from the app's current image.
  scheduled_run
  /// Changes a managed database's version: backup, then in place, or a new service, restore, verify and switch.
  service_upgrade
}

enum EmailCodePurpose {
  verify
  change
  /// Confirms a password change from Settings, Security while email is on.
  password
}

enum JobLane {
  deploy
  data
  maintenance
  /// Claimed only by the self-updater, never by the worker loop.
  update
  /// New app's repository read, so it never waits behind a long build.
  detect
  /// Scheduled job runs. The worker runs a fixed number of claim loops here: the server's concurrency cap.
  cron
}

enum CfDomainState {
  /// Tunnel mode off, or Cloudflare not connected.
  none
  /// Wire job queued.
  pending
  /// Dockify created the record and the tunnel rule (ids on the row).
  managed
  /// A hand-made record or rule exists; Dockify left it alone.
  external
  failed
}

