/// What the app is doing now, as the daemon reports it: the worker's observe pass writes the
/// observed container state, a deploy writes deploying, and a first deploy that failed is failed.
/// degraded: running but failing its health check. restarting: Docker is restarting it, or it is
/// crash looping. exited: its container stopped on its own while it should run. missing: it should
/// run and has no container. Values after unknown arrived in migration 0007 (ADD VALUE appends).
enum AppStatus {
  running
  stopped
  deploying
  degraded
  unknown
  restarting
  exited
  missing
  failed
}

enum DesiredState {
  running
  stopped
}

enum DeployTarget {
  server
  vercel
}

