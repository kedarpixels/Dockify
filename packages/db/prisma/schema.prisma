// Dockify control-plane schema. Rules: every timestamp is timestamptz, every encrypted value lives
// in `secrets` and is referenced by id, status-like columns are enums, and nothing important is
// invisible to Prisma (CHECK constraints in the init migration are the only hand-written SQL).
// Operational tables carry their retention rule in the model comment; the janitor enforces it.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

